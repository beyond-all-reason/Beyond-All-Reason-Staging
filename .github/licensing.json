{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "Shared licensing rules read by .github/scripts/licensing.js (CLA bot) and tools/license_auditor (desktop auditor).",
  "art_dirs": [
    "anims",
    "bitmaps",
    "fonts",
    "icons",
    "modelmaterials",
    "modelmaterials_gl4",
    "music",
    "objects3d",
    "sidepics",
    "sounds",
    "unitpics",
    "unittextures",
    "luaui/images",
    "luaui/sounds",
    "luarules/images",
    "singleplayer/scenarios"
  ],
  "art_extensions": [
    "s3o", "obj", "fbx", "dae", "3ds",
    "png", "jpg", "jpeg", "tga", "dds", "bmp", "gif", "svg", "psd", "xcf",
    "ogg", "wav", "mp3", "flac", "opus",
    "bvh",
    "blend", "kra", "spr",
    "ttf", "otf", "ttc"
  ],
  "code_extensions": ["glsl", "frag", "vert", "glslf", "glslv", "bos", "cob", "lua", "py"],
  "doc_extensions": ["md", "ipynb"],
  "notice_stem_pattern": "licen[cs]e|^ofl(?:$|[-_])",
  "licenses": {
    "LicenseRef-BAR-CLA-1.0": { "name": "BAR Project License (CLA)", "label": "license: BAR-CLA", "blurb": "restricted to BAR; you keep copyright.", "doc": "legal/CLA_SUMMARY.md" },
    "CC-BY-SA-4.0": { "name": "CC-BY-SA 4.0", "label": "license: CC-BY-SA-4.0", "blurb": "openly reusable by anyone with attribution. Cannot be revoked once recorded.", "doc": "legal/CC-BY-SA-OPT-IN.md" },
    "GPL-2.0-or-later": { "name": "GPL-2.0-or-later", "label": "license: GPL" },
    "MIT": { "name": "MIT", "label": "license: MIT" },
    "CC0-1.0": { "name": "CC0 1.0 (public domain)", "label": "license: CC0" },
    "OFL-1.1": { "name": "SIL Open Font License 1.1", "label": "license: OFL" },
    "CC-BY-SA-3.0": { "name": "CC-BY-SA 3.0", "label": "license: CC-BY-SA-3.0" },
    "CC-BY-NC-ND-4.0": { "name": "CC-BY-NC-ND 4.0 (legacy)", "label": "license: CC-BY-NC-ND" }
  },
  "pr_choices": ["LicenseRef-BAR-CLA-1.0", "CC-BY-SA-4.0"],
  "ledger": {
    "signatures": ".github/cla-signatures.json",
    "assignments": ".github/file-license-assignments.json",
    "flags": "license_comments_flags.json"
  },
  "bot": { "name": "BAR CLA Bot", "email": "cla-bot@beyondallreason.info" },
  "status_context": "BAR CLA / License Check",
  "legal_dir": "legal"
}
